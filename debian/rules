#!/usr/bin/make -f

export PEP440_VERSION := $(shell dpkg-parsechangelog -S Version | cut -d- -f1 | sed 's/^[0-9]*://;s/~alpha/a/;s/~beta/b/;s/~rc/rc/')

# This source package builds two independent wheels from two separate
# pyproject.toml roots in the same monorepo: the root one (mcp, packages
# src/mcp) and src/mcp-types/pyproject.toml (mcp-types, the wire-types
# dependency mcp now requires). dh_auto_* is therefore invoked twice per
# step, once per --sourcedirectory, each installed to its own binary
# package's destdir.
%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_configure:
	# Both pyproject.toml files declare a uv-dynamic-versioning-sourced
	# version (and, for the root one, a dynamic dependency list); neither
	# the plugin nor a git checkout with tags is available in a Debian
	# build, so pin both statically from the changelog version first.
	python3 debian/patch-dynamic-pyproject.py pyproject.toml "$(PEP440_VERSION)" --inline-dependencies
	python3 debian/patch-dynamic-pyproject.py src/mcp-types/pyproject.toml "$(PEP440_VERSION)"
	dh_auto_configure --sourcedirectory=.
	dh_auto_configure --sourcedirectory=src/mcp-types

override_dh_auto_build:
	PYBUILD_NAME=mcp dh_auto_build --sourcedirectory=.
	PYBUILD_NAME=mcp_types dh_auto_build --sourcedirectory=src/mcp-types

override_dh_auto_test:
	# Skip tests

override_dh_auto_install:
	PYBUILD_NAME=mcp dh_auto_install --sourcedirectory=. --destdir=debian/python3-mcp
	PYBUILD_NAME=mcp_types dh_auto_install --sourcedirectory=src/mcp-types --destdir=debian/python3-mcp-types

override_dh_install:
	dh_install --sourcedir=.

override_dh_auto_clean:
	dh_auto_clean
	# Restore if needed
	git checkout pyproject.toml src/mcp-types/pyproject.toml 2>/dev/null || true
